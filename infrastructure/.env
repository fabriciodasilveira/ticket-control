# Database
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/taskmanager

# Redis
REDIS_URL=redis://redis:6379/0

# Security
SECRET_KEY=your-secret-key-change-in-production-123456789
DEBUG=true

# CORS
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080"]

# Cloudflare R2 (Optional for tests)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=taskmanager-evidence
R2_PUBLIC_URL=https://cdn.taskmanager.com

# Email SMTP (Optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@taskmanager.com
